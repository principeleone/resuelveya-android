<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ResuelveYa.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ResuelveYa.Title"
            app:layout_constraintEnd_toStartOf="@id/tvDisponible"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Juan Ramos Torres" />

        <TextView
            android:id="@+id/tvEspecialidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ResuelveYa.Caption"
            app:layout_constraintEnd_toStartOf="@id/tvDisponible"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvNombre"
            tools:text="Electricista · Desde S/ 50" />

        <ImageView
            android:id="@+id/ivEstrella"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvEspecialidad"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tvCalificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.ResuelveYa.Caption"
            app:layout_constraintBottom_toBottomOf="@id/ivEstrella"
            app:layout_constraintStart_toEndOf="@id/ivEstrella"
            app:layout_constraintTop_toTopOf="@id/ivEstrella"
            tools:text="4.8 · 120 trabajos" />

        <TextView
            android:id="@+id/tvDisponible"
            style="@style/Widget.ResuelveYa.Estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_ok"
            android:textColor="@color/chip_ok_tx"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Disponible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>