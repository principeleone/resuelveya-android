    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnEnviar" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="@dimen/spacing_lg" android:layout_marginEnd="@dimen/spacing_lg" android:layout_marginBottom="@dimen/spacing_lg" style="@style/Widget.ResuelveYa.Button" android:text="@string/solicitudes_btn_enviar"/>
</androidx.constraintlayout.widget.ConstraintLayout>