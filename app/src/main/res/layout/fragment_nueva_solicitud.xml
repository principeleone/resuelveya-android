                    <TextView android:id="@+id/tvProveedorNombre" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/ivFoto" app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="@dimen/spacing_md" android:textAppearance="@style/TextAppearance.ResuelveYa.Title" tools:text="Juan Ramos Torres"/>
                    <TextView android:id="@+id/tvServicioTarifa" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/tvProveedorNombre" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/ivFoto" app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="@dimen/spacing_md" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.ResuelveYa.Caption" tools:text="Revisión eléctrica · S/ 50"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDescripcion" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/cardProveedor" android:layout_marginTop="@dimen/spacing_lg" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:hint="@string/solicitudes_descripcion" app:counterEnabled="true" app:counterMaxLength="300">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilFecha" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/tilDescripcion" android:layout_marginTop="@dimen/spacing_md" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:hint="@string/solicitudes_fecha" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_calendar">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:focusable="false" android:clickable="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilHora" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/tilFecha" android:layout_marginTop="@dimen/spacing_md" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:hint="@string/solicitudes_hora" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_schedule">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etHora" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:focusable="false" android:clickable="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDireccion" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/tilHora" android:layout_marginTop="@dimen/spacing_md" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:hint="@string/solicitudes_direccion" app:startIconDrawable="@drawable/ic_location">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDireccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/tvBannerOffline" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/tilDireccion" android:layout_marginTop="@dimen/spacing_lg" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:textAppearance="@style/TextAppearance.ResuelveYa.Caption" android:text="@string/solicitudes_offline" android:background="@drawable/bg_banner_offline" android:padding="10dp" android:textColor="@color/chip_pen_tx" android:drawableStart="@drawable/ic_cloud_off" android:drawablePadding="8dp" android:drawableTint="@color/chip_pen_tx" android:visibility="gone"/>
