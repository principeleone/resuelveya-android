<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_cliente"
    app:startDestination="@id/inicioClienteFragment">

    <fragment
        android:id="@+id/inicioClienteFragment"
        android:name="com.resuelveya.android.features.catalogo.view.InicioClienteFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_inicio_cliente">
        <action
            android:id="@+id/action_inicioClienteFragment_to_proveedoresFragment"
            app:destination="@id/proveedoresFragment" />
        <action
            android:id="@+id/action_inicioClienteFragment_to_proveedorDetalleFragment"
            app:destination="@id/proveedorDetalleFragment" />
    </fragment>

    <fragment
        android:id="@+id/proveedoresFragment"
        android:name="com.resuelveya.android.features.catalogo.view.ProveedoresFragment"
        android:label="Técnicos"
        tools:layout="@layout/fragment_proveedores">
        <action
            android:id="@+id/action_proveedoresFragment_to_proveedorDetalleFragment"
            app:destination="@id/proveedorDetalleFragment" />
    </fragment>

    <fragment
        android:id="@+id/proveedorDetalleFragment"
        android:name="com.resuelveya.android.features.catalogo.view.ProveedorDetalleFragment"
        android:label="Detalle del Técnico"
        tools:layout="@layout/fragment_proveedor_detalle">
        <action
            android:id="@+id/action_proveedorDetalleFragment_to_nuevaSolicitudFragment"
            app:destination="@id/nuevaSolicitudFragment" />
    </fragment>

    <fragment
        android:id="@+id/nuevaSolicitudFragment"
        android:name="com.resuelveya.android.features.solicitudes.view.NuevaSolicitudFragment"
        android:label="Nueva Solicitud"
        tools:layout="@layout/fragment_nueva_solicitud">
        <action
            android:id="@+id/action_nuevaSolicitudFragment_to_misContratacionesFragment"
            app:destination="@id/misContratacionesFragment"
            app:popUpTo="@id/inicioClienteFragment" />
    </fragment>

    <fragment
        android:id="@+id/misContratacionesFragment"
        android:name="com.resuelveya.android.features.contrataciones.view.MisContratacionesFragment"
        android:label="Contratos"
        tools:layout="@layout/fragment_mis_contrataciones" />

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.resuelveya.android.features.perfil.view.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />

</navigation>